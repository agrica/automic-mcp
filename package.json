{
  "name": "@agrica/automic-mcp",
  "version": "0.1.1",
  "description": "MCP server for the Automic Automation (AE) REST API v1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "bin": {
    "automic-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "npm run build && vitest run --project e2e",
    "lint:workflows": "node scripts/validate-yaml.mjs .github/workflows/ci.yml .github/workflows/release.yml .github/dependabot.yml"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
